-function sendMessage(){
-  const text = input.value.trim();
-  if(!text) return;
-  const meta = convMeta();
-
-  // $task command
-  const taskM = text.match(/^\$task\s+(.+)/i);
-  if(taskM){
-    const desc=taskM[1].trim();
-    const chName = currentConv.kind==="channel"?channels.find(c=>c.id===meta.id).name:"general";
-    const n=nextTaskN++;
-    tasks.unshift({ n, desc, state:"open", channel:chName });
-    const sys=M(null, nowTime(), ""); sys.system=`You created task #${n} · ${desc}`;
-    (messages[meta.id]=messages[meta.id]||[]).push(sys);
-    document.getElementById("msgsInner").appendChild(messageEl(sys));
-    clearComposer(); scrollBottom(true); toast("Task #"+n+" created");
-    return;
-  }
-
-  // broadcast confirm: untargeted in a channel with multiple agents
-  const inline=parseSigils(text);
-  const hasTarget = composerTargets.length>0 || inline.some(s=>s.sig==="@"||s.sig==="!") || composerMode==="broadcast";
-  const roster=currentRoster();
-  if(currentConv.kind==="channel" && !hasTarget && roster.length>1){
-    confirmDialog("Send to the whole room?", `This message isn't targeted at anyone. It'll post ambiently to #${channels.find(c=>c.id===meta.id).name} — the ${roster.length} agents here will see it but sleeping ones won't wake. Add @name to reach someone directly.`, "Post ambiently", ()=>doSend(text,meta,"ambient"));
-    return;
-  }
-  doSend(text,meta, composerMode==="broadcast"?"broadcast":(hasTarget?"targeted":"ambient"));
-}
-function msgTypeFor(text){
-  const s=parseSigils(text);
-  if(s.some(x=>x.sig==="!")) return "bang";
-  if(composerTargets.some(t=>t.sig==="!")) return "bang";
-  if(s.some(x=>x.sig==="@")||composerTargets.some(t=>t.sig==="@")) return "mention";
-  return null;
-}
-function clearComposer(){ input.value=""; input.style.height="auto"; document.getElementById("sendBtn").disabled=true; composerTargets=[]; renderTargets(); updatePreview(); document.getElementById("acPop").classList.add("hidden"); }
-function doSend(text, meta, reach){
-  const type=msgTypeFor(text);
-  const msg = M("you", nowTime(), "<p>"+esc(text).replace(/\n/g,"<br>")+"</p>", type?{type}:{});
-  if(currentConv.kind==="dm") msg.dm=true;
-  (messages[meta.id] = messages[meta.id]||[]).push(msg);
-  document.getElementById("msgsInner").appendChild(messageEl(msg));
-  clearComposer(); scrollBottom(true);
-
-  const d = dms.find(x=>x.id===meta.id);
-  if(d && d.type==="agent") return; // observing only
-  maybeAgentReply(meta, reach);
-}
