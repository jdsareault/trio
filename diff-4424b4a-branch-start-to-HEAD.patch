++    # ── db helpers ──
++    def _db(self) -> sqlite3.Connection:
++        conn = sqlite3.connect(str(self.db_path), timeout=10)
++        conn.row_factory = sqlite3.Row
++        conn.execute("PRAGMA busy_timeout=5000")
