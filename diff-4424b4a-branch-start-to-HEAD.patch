++    "connect", "send", "dm", "poll", "ack", "pounds", "ask",
++    "claim", "complete", "cancel", "release", "lock", "unlock",
++    "set_status", "rename", "status", "roster", "history", "end",
++    "list", "cull", "cleanup", "retract",
++)
