+-function nowTime(){
+-  const d=new Date();
+-  let h=d.getHours(), m=d.getMinutes();
+-  const ap = h>=12?"PM":"AM"; h=h%12||12;
+-  return `${h}:${String(m).padStart(2,"0")} ${ap}`;
+-}
+-function sendMessage(){
+-  const text = input.value.trim();
+-  if(!text) return;
+-  const meta = convMeta();
+-
+-  // $task command
+-  const taskM = text.match(/^\$task\s+(.+)/i);
+-  if(taskM){
+-    const desc=taskM[1].trim();
+-    const chName = currentConv.kind==="channel"?channels.find(c=>c.id===meta.id).name:"general";
+-    const n=nextTaskN++;
+-    tasks.unshift({ n, desc, state:"open", channel:chName });
+-    const sys=M(null, nowTime(), ""); sys.system=`You created task #${n} · ${desc}`;
+-    (messages[meta.id]=messages[meta.id]||[]).push(sys);
+-    document.getElementById("msgsInner").appendChild(messageEl(sys));
+-    clearComposer(); scrollBottom(true); toast("Task #"+n+" created");
+-    return;
+-  }
+-
+-  // broadcast confirm: untargeted in a channel with multiple agents
+-  const inline=parseSigils(text);
+-  const hasTarget = composerTargets.length>0 || inline.some(s=>s.sig==="@"||s.sig==="!") || composerMode==="broadcast";
+-  const roster=currentRoster();
+-  if(currentConv.kind==="channel" && !hasTarget && roster.length>1){
+-    confirmDialog("Send to the whole room?", `This message isn't targeted at anyone. It'll post ambiently to #${channels.find(c=>c.id===meta.id).name} — the ${roster.length} agents here will see it but sleeping ones won't wake. Add @name to reach someone directly.`, "Post ambiently", ()=>doSend(text,meta,"ambient"));
+-    return;
+-  }
+-  doSend(text,meta, composerMode==="broadcast"?"broadcast":(hasTarget?"targeted":"ambient"));
+-}
+-function msgTypeFor(text){
+-  const s=parseSigils(text);
+-  if(s.some(x=>x.sig==="!")) return "bang";
+-  if(composerTargets.some(t=>t.sig==="!")) return "bang";
+-  if(s.some(x=>x.sig==="@")||composerTargets.some(t=>t.sig==="@")) return "mention";
+-  return null;
+-}
+-function clearComposer(){ input.value=""; input.style.height="auto"; document.getElementById("sendBtn").disabled=true; composerTargets=[]; renderTargets(); updatePreview(); document.getElementById("acPop").classList.add("hidden"); }
+-function doSend(text, meta, reach){
+-  const type=msgTypeFor(text);
+-  const msg = M("you", nowTime(), "<p>"+esc(text).replace(/\n/g,"<br>")+"</p>", type?{type}:{});
+-  if(currentConv.kind==="dm") msg.dm=true;
+-  (messages[meta.id] = messages[meta.id]||[]).push(msg);
+-  document.getElementById("msgsInner").appendChild(messageEl(msg));
+-  clearComposer(); scrollBottom(true);
+-
+-  const d = dms.find(x=>x.id===meta.id);
+-  if(d && d.type==="agent") return; // observing only
+-  maybeAgentReply(meta, reach);
+-}
+-
+-let typingTimer=null;
+-function maybeAgentReply(meta, reach){
+-  const showTyping = document.getElementById("pref-typing").checked;
+-  // pick a responder
+-  let responder;
+-  if(currentConv.kind==="channel"){
+-    const c = channels.find(x=>x.id===meta.id);
+-    const cands = c.members.filter(id=>agentById(id) && AWAKE.has(agentById(id).status));
+-    responder = cands[Math.floor(Math.random()*cands.length)] || c.members[0];
+-  } else {
+-    responder = meta.members[0];
+-  }
+-  const a = agentById(responder);
+-  if(!a) return;
+-  const wrap = document.getElementById("msgsInner");
+-
+-  // waking a sleeping/stopped agent from a DM
+-  if(currentConv.kind==="dm" && (a.status==="sleeping"||a.status==="stopped")){
+-    const sys=M(null,nowTime(),""); sys.system=`${a.name} is waking up — restoring context…`;
+-    wrap.appendChild(messageEl(sys)); scrollBottom(true);
+-    a.status="spawning";
+-    setTimeout(()=>{ a.status="active"; a.statusText="Awake — context restored"; a.lastActive="just now"; renderSidebar(); reallyReply(a,meta); }, reduceMotion()?300:1400);
+-    return;
+-  }
+-  // queued behind an active turn
+-  if(a.status==="working" && Math.random()<0.5){
+-    const sys=M(null,nowTime(),""); sys.system=`Message queued — ${a.name} is finishing a turn`;
+-    wrap.appendChild(messageEl(sys)); scrollBottom(true);
+-    setTimeout(()=>reallyReply(a,meta), reduceMotion()?350:1600);
+-    return;
+-  }
+-  reallyReply(a,meta);
+-}
+-function reallyReply(a,meta){
+-  const responder=a.id;
+-  const showTyping = document.getElementById("pref-typing").checked;
+-  const wrap = document.getElementById("msgsInner");
+-  let typingEl=null;
+-  if(showTyping){
+-    typingEl = document.createElement("div");
+-    typingEl.className="typing";
+-    typingEl.appendChild(avatarEl(a,40,false));
+-    const tb=document.createElement("div"); tb.className="tb"; tb.innerHTML="<i></i><i></i><i></i>";
+-    typingEl.appendChild(tb);
+-    const who=document.createElement("span"); who.className="who-t"; who.textContent=a.name+" is thinking";
+-    typingEl.appendChild(who);
+-    wrap.appendChild(typingEl);
+-    scrollBottom(true);
+-  }
+-
+-  clearTimeout(typingTimer);
+-  typingTimer = setTimeout(()=>{
+-    if(typingEl) typingEl.remove();
+-    const reply = M(responder, nowTime(), "<p>"+esc(CANNED[Math.floor(Math.random()*CANNED.length)])+"</p>");
+-    (messages[meta.id]=messages[meta.id]||[]).push(reply);
+-    // guard: only render if still viewing this conv
+-    if(currentView==="chat" && convMeta().id===meta.id){
+-      wrap.appendChild(messageEl(reply));
+-      scrollBottom(true);
+-    }
+-  }, reduceMotion()?350:1500);
+-}
