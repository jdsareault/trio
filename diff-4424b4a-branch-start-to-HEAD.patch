+
+/* messages */
+.msgs{ flex:1; min-height:0; overflow-y:auto; padding:22px 0 8px; }
+.msgs-inner{ max-width:820px; margin:0 auto; padding:0 26px; }
+
+.day-sep{ display:flex; align-items:center; gap:14px; margin:18px 2px 20px; }
