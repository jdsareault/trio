+-      // hidden would leave us at the bottom on return, so the "new messages"
+-      // divider for what arrived while away would be marked caught-up and lost.
+-      chat.scrollTop = chat.scrollHeight;
+-    } else {
+-      state.jumpUnread++;
+-      updateJumpButton();
+-    }
