+<!doctype html>
+<html lang="en" data-theme="light" data-accent="eucalyptus">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1" />
+<title>Atrium — chat with your agents</title>
+<link rel="preconnect" href="https://fonts.googleapis.com" />
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
+<style>
+/* ============================================================
+   ATRIUM — design tokens
+   ============================================================ */
+:root{
+  /* type */
+  --font-display: "Fraunces", Georgia, serif;
+  --font-body: "Hanken Grotesk", system-ui, -apple-system, sans-serif;
+
+  /* radii */
+  --r-xs: 8px;
+  --r-sm: 12px;
+  --r-md: 16px;
+  --r-lg: 22px;
+  --r-xl: 30px;
+  --r-full: 999px;
+
+  /* spacing rhythm */
+  --sp-1: 4px;  --sp-2: 8px;  --sp-3: 12px; --sp-4: 16px;
+  --sp-5: 24px; --sp-6: 32px; --sp-7: 48px;
+
+  /* motion */
+  --ease: cubic-bezier(.22,.61,.36,1);
+  --ease-soft: cubic-bezier(.34,1.2,.64,1);
+  --dur: .28s;
+
+  /* ---- LIGHT THEME (warm greige / dusty-rose paper) ---- */
+  --bg: #ece7e1;                 /* room */
+  --bg-sink: #e3ddd5;            /* recessed */
+  --surface: #f7f4ef;           /* raised cards */
+  --surface-2: #fbf9f6;         /* highest */
+  --surface-hover: #f0ebe4;
+  --sidebar: #efe9e2;
+  --line: #ddd4c9;              /* hairlines */
+  --line-soft: #e6ded4;
+
+  --ink: #2c2723;               /* primary text */
+  --ink-2: #5c554d;             /* secondary */
+  --ink-3: #8b8378;             /* muted */
+  --ink-inv: #f7f4ef;
+
+  --bubble-me: var(--accent);
+  --bubble-me-ink: #ffffff;
+  --bubble-agent: #ffffff;
+  --bubble-agent-ink: var(--ink);
+
+  --shadow-sm: 0 1px 2px rgba(58,48,38,.06), 0 1px 3px rgba(58,48,38,.05);
+  --shadow-md: 0 4px 14px rgba(58,48,38,.09), 0 2px 6px rgba(58,48,38,.05);
+  --shadow-lg: 0 18px 50px rgba(48,38,28,.18), 0 6px 18px rgba(48,38,28,.10);
+  --shadow-pop: 0 12px 40px rgba(48,38,28,.22);
+
+  --code-bg: #efe9e1;
+  --code-ink: #6b4f66;
+
+  --focus: color-mix(in oklab, var(--accent) 55%, transparent);
+
+  /* warm secondary accent (apricot) shared by both themes, tuned per theme */
+  --warm: #d98a5b;
+  --warm-soft: color-mix(in oklab, var(--warm) 18%, var(--surface));
+
+  /* status */
+  --st-online: #5b9a6f;
+  --st-thinking: #c98a3c;
+  --st-idle: #b0a99d;
+  --st-offline: #b9b1a6;
+}
+
+/* accent variants (light) */
+:root[data-accent="eucalyptus"]{ --accent:#3d7a63; --accent-strong:#316451; --accent-tint:#e3ede7; }
+:root[data-accent="indigo"]    { --accent:#4b52a8; --accent-strong:#3c4290; --accent-tint:#e6e7f4; }
+:root[data-accent="plum"]      { --accent:#8a4f78; --accent-strong:#743f64; --accent-tint:#f1e6ee; }
+
+/* ---- DARK THEME (deep warm charcoal, not black) ---- */
+:root[data-theme="dark"]{
+  --bg: #1a1714;
+  --bg-sink: #14110f;
+  --surface: #26221e;
+  --surface-2: #2f2a25;
+  --surface-hover: #302b25;
+  --sidebar: #201c19;
+  --line: #3a342d;
+  --line-soft: #322d27;
+
+  --ink: #f0e9df;
+  --ink-2: #c3b9ab;
+  --ink-3: #8f867a;
+  --ink-inv: #1a1714;
+
+  --bubble-me-ink: #ffffff;
+  --bubble-agent: #2f2a25;
+  --bubble-agent-ink: var(--ink);
+
+  --shadow-sm: 0 1px 2px rgba(0,0,0,.35);
+  --shadow-md: 0 6px 18px rgba(0,0,0,.42);
+  --shadow-lg: 0 22px 60px rgba(0,0,0,.6), 0 8px 22px rgba(0,0,0,.45);
+  --shadow-pop: 0 14px 46px rgba(0,0,0,.6);
+
+  --code-bg: #201c18;
+  --code-ink: #d9a6cd;
+
+  --warm: #e09a6b;
+  --warm-soft: color-mix(in oklab, var(--warm) 16%, var(--surface));
+
+  --st-idle: #6f685d;
+  --st-offline: #58524a;
+}
+:root[data-theme="dark"][data-accent="eucalyptus"]{ --accent:#65b090; --accent-strong:#79c1a2; --accent-tint:#26362f; }
+:root[data-theme="dark"][data-accent="indigo"]    { --accent:#8e94e6; --accent-strong:#a4a9ef; --accent-tint:#2a2c44; }
+:root[data-theme="dark"][data-accent="plum"]      { --accent:#c98cb6; --accent-strong:#d6a2c6; --accent-tint:#3a2a36; }
+
+/* ============================================================
+   base
+   ============================================================ */
+*{ box-sizing:border-box; }
+html,body{ height:100%; }
+body{
+  margin:0;
+  font-family:var(--font-body);
+  background:var(--bg);
+  color:var(--ink);
+  font-size:15px;
+  line-height:1.5;
+  -webkit-font-smoothing:antialiased;
+  text-rendering:optimizeLegibility;
+  overflow:hidden;
+  transition:background var(--dur) var(--ease), color var(--dur) var(--ease);
+}
+button{ font-family:inherit; font-size:inherit; color:inherit; cursor:pointer; border:none; background:none; }
+input,textarea,select{ font-family:inherit; font-size:inherit; color:inherit; }
+h1,h2,h3,h4{ margin:0; font-weight:600; }
+::selection{ background:var(--accent-tint); }
+
+:focus-visible{ outline:2.5px solid var(--focus); outline-offset:2px; border-radius:6px; }
+
+/* scrollbars */
+*{ scrollbar-width:thin; scrollbar-color: color-mix(in oklab, var(--ink-3) 45%, transparent) transparent; }
+*::-webkit-scrollbar{ width:10px; height:10px; }
+*::-webkit-scrollbar-thumb{
+  background:color-mix(in oklab, var(--ink-3) 40%, transparent);
+  border-radius:20px; border:3px solid transparent; background-clip:padding-box;
+}
+*::-webkit-scrollbar-thumb:hover{ background:color-mix(in oklab, var(--ink-3) 65%, transparent); background-clip:padding-box; }
+*::-webkit-scrollbar-track{ background:transparent; }
+
+/* ============================================================
+   app shell
+   ============================================================ */
+.app{
+  display:grid;
+  grid-template-columns: 300px minmax(0,1fr);
+  height:100vh;
+  height:100dvh;
+}
+@media (max-width: 880px){
+  .app{ grid-template-columns: 1fr; }
+  .sidebar{ position:fixed; z-index:60; inset:0 auto 0 0; width:300px; transform:translateX(-105%); transition:transform var(--dur) var(--ease); box-shadow:var(--shadow-lg); }
+  .app.nav-open .sidebar{ transform:translateX(0); }
+  .scrim-nav{ display:block; }
+}
+
+/* ============================================================
+   sidebar
+   ============================================================ */
+.sidebar{
+  background:var(--sidebar);
+  border-right:1px solid var(--line);
+  display:flex; flex-direction:column;
+  min-height:0;
+}
+.brand{
+  display:flex; align-items:center; gap:12px;
+  padding:20px 20px 16px;
+}
+.brand-mark{
+  width:38px; height:38px; border-radius:12px; flex:none;
+  background:linear-gradient(150deg, var(--accent), var(--accent-strong));
+  display:grid; place-items:center; color:#fff;
+  box-shadow:var(--shadow-sm);
+  position:relative;
+}
+.brand-mark svg{ width:21px; height:21px; }
+.brand-name{ font-family:var(--font-display); font-size:22px; font-weight:600; letter-spacing:-.01em; }
+.brand-sub{ font-size:11.5px; color:var(--ink-3); margin-top:-2px; font-weight:500; letter-spacing:.02em; }
+
+.workspace-switch{ margin-left:auto; }
+.icon-btn{
+  width:34px; height:34px; border-radius:10px; display:grid; place-items:center;
+  color:var(--ink-2); transition:background var(--dur) var(--ease), color var(--dur) var(--ease), transform .12s var(--ease);
+}
+.icon-btn:hover{ background:var(--surface-hover); color:var(--ink); }
+.icon-btn:active{ transform:scale(.92); }
+.icon-btn svg{ width:19px; height:19px; }
+
+.nav-scroll{ flex:1; min-height:0; overflow-y:auto; padding:4px 12px 18px; }
+
+.nav-section{ margin-top:14px; }
+.nav-head{
+  display:flex; align-items:center; justify-content:space-between;
+  padding:6px 10px 6px 12px;
+}
+.nav-head h3{
+  font-size:11.5px; letter-spacing:.09em; text-transform:uppercase;
+  color:var(--ink-3); font-weight:700;
+}
+.add-btn{
+  width:24px; height:24px; border-radius:7px; display:grid; place-items:center;
+  color:var(--ink-3); transition:all var(--dur) var(--ease);
+}
+.add-btn:hover{ background:var(--accent-tint); color:var(--accent-strong); }
+.add-btn svg{ width:15px; height:15px; }
+
+.nav-item{
+  display:flex; align-items:center; gap:10px;
+  width:100%; text-align:left;
+  padding:8px 10px; border-radius:12px;
+  color:var(--ink-2); font-weight:500; font-size:14.5px;
+  transition:background .16s var(--ease), color .16s var(--ease);
+  position:relative;
+}
+.nav-item:hover{ background:var(--surface-hover); color:var(--ink); }
+.nav-item.active{ background:var(--surface-2); color:var(--ink); box-shadow:var(--shadow-sm); font-weight:600; }
+.nav-item.active::before{
+  content:""; position:absolute; left:-12px; top:50%; transform:translateY(-50%);
+  width:4px; height:20px; border-radius:0 4px 4px 0; background:var(--accent);
+}
+.nav-hash{ color:var(--ink-3); font-weight:600; width:16px; text-align:center; flex:none; }
+.nav-item.active .nav-hash{ color:var(--accent-strong); }
+.nav-label{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.nav-meta{ display:flex; align-items:center; gap:7px; flex:none; }
+
+.unread-dot{ width:8px; height:8px; border-radius:50%; background:var(--warm); box-shadow:0 0 0 3px color-mix(in oklab,var(--warm) 22%, transparent); }
+.badge{
+  min-width:19px; height:19px; padding:0 6px; border-radius:999px;
+  background:var(--accent); color:#fff; font-size:11px; font-weight:700;
+  display:grid; place-items:center; line-height:1;
+}
+
+/* avatar */
+.av{
+  border-radius:50%; flex:none; display:grid; place-items:center;
+  color:#fff; font-weight:700; font-family:var(--font-body);
+  position:relative; letter-spacing:.01em;
+  box-shadow: inset 0 0 0 1px rgba(255,255,255,.14);
+}
+.av.sq{ border-radius:11px; }
+.av-28{ width:28px; height:28px; font-size:12px; }
+.av-32{ width:32px; height:32px; font-size:13px; }
+.av-40{ width:40px; height:40px; font-size:15px; }
+.av-48{ width:48px; height:48px; font-size:18px; }
+.av-64{ width:64px; height:64px; font-size:24px; }
+.av .st-ring{
+  position:absolute; right:-1px; bottom:-1px;
+  width:12px; height:12px; border-radius:50%;
+  border:2.5px solid var(--sidebar);
+}
+.dm-item .av .st-ring{ border-color:var(--sidebar); }
+.st-online .st-ring, .st-dot.online{ background:var(--st-online); }
+.st-thinking .st-ring, .st-dot.thinking{ background:var(--st-thinking); }
+.st-idle .st-ring, .st-dot.idle{ background:var(--st-idle); }
+.st-offline .st-ring, .st-dot.offline{ background:var(--st-offline); }
+
+.dm-pair{ position:relative; width:30px; height:28px; flex:none; }
+.dm-pair .av{ position:absolute; box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 0 0 2px var(--sidebar); }
+.dm-pair .av:first-child{ left:0; top:0; }
+.dm-pair .av:last-child{ right:0; bottom:0; }
+
+/* sidebar footer / user */
+.side-foot{
+  border-top:1px solid var(--line);
+  padding:10px 12px;
+  display:flex; align-items:center; gap:10px;
+}
+.side-foot .who{ min-width:0; flex:1; }
+.side-foot .who .n{ font-weight:600; font-size:13.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.side-foot .who .s{ font-size:11.5px; color:var(--ink-3); }
+
+/* ============================================================
+   main / conversation
+   ============================================================ */
+.main{ min-width:0; min-height:0; display:flex; flex-direction:column; background:var(--bg); position:relative; }
+
+.topbar{
+  display:flex; align-items:center; gap:14px;
+  padding:14px 22px;
+  border-bottom:1px solid var(--line);
+  background:color-mix(in oklab, var(--bg) 78%, transparent);
+  backdrop-filter:blur(8px);
+  min-height:66px;
+}
+.hamb{ display:none; }
+@media (max-width:880px){ .hamb{ display:grid; } }
+
+.topbar .tt{ min-width:0; flex:1; }
+.topbar h2{ font-family:var(--font-display); font-size:19px; font-weight:600; letter-spacing:-.01em; display:flex; align-items:center; gap:8px; }
+.topbar h2 .h{ color:var(--ink-3); font-weight:500; }
+.topbar .topic{ font-size:12.5px; color:var(--ink-3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:1px; }
+.topbar-actions{ display:flex; align-items:center; gap:6px; }
+
+.face-pile{ display:flex; align-items:center; padding-right:6px; }
+.face-pile .av{ margin-left:-8px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 0 0 2.5px var(--bg); }
+.face-pile .more{
+  margin-left:-8px; width:28px; height:28px; border-radius:50%; background:var(--surface);
+  display:grid; place-items:center; font-size:11px; font-weight:700; color:var(--ink-2);
+  box-shadow: 0 0 0 2.5px var(--bg); border:1px solid var(--line);
+}
+
+/* messages */
+.msgs{ flex:1; min-height:0; overflow-y:auto; padding:22px 0 8px; }
+.msgs-inner{ max-width:820px; margin:0 auto; padding:0 26px; }
+
+.day-sep{ display:flex; align-items:center; gap:14px; margin:18px 2px 20px; }
+.day-sep::before, .day-sep::after{ content:""; height:1px; flex:1; background:var(--line); }
+.day-sep span{
+  font-size:11.5px; font-weight:700; letter-spacing:.05em; color:var(--ink-3);
+  background:var(--surface); padding:3px 12px; border-radius:999px; box-shadow:var(--shadow-sm);
+}
+
+.msg{ display:flex; gap:12px; padding:3px 0; animation:msgIn .34s var(--ease) both; }
+.msg.me{ flex-direction:row-reverse; }
+@keyframes msgIn{ from{ opacity:0; transform:translateY(8px); } to{ opacity:1; transform:none; } }
+
+.msg .av{ margin-top:2px; }
+.msg-body{ min-width:0; max-width:72%; display:flex; flex-direction:column; }
+.msg.me .msg-body{ align-items:flex-end; }
+
+.msg-head{ display:flex; align-items:baseline; gap:8px; margin:0 4px 3px; }
+.msg-head .nm{ font-weight:700; font-size:13.5px; }
+.msg-head .rl{ font-size:11px; color:var(--ink-3); font-weight:500; }
+.msg-head .tm{ font-size:11px; color:var(--ink-3); }
+
+.bubble{
+  background:var(--bubble-agent); color:var(--bubble-agent-ink);
+  padding:11px 15px; border-radius:6px 18px 18px 18px;
+  box-shadow:var(--shadow-sm);
+  font-size:14.5px; line-height:1.55;
+  border:1px solid var(--line-soft);
+  position:relative; word-wrap:break-word;
+}
+.msg.me .bubble{
+  background:var(--bubble-me); color:var(--bubble-me-ink);
+  border-radius:18px 6px 18px 18px; border-color:transparent;
+  box-shadow:var(--shadow-md);
+}
+.bubble + .bubble{ margin-top:4px; border-radius:18px; }
+.msg.me .bubble + .bubble{ border-radius:18px; }
+.bubble p{ margin:0; }
+.bubble p + p{ margin-top:7px; }
+.bubble a{ color:var(--accent-strong); text-decoration:underline; text-underline-offset:2px; }
+.msg.me .bubble a{ color:#fff; }
+
+.bubble code.inline{
+  font-family:"SF Mono", ui-monospace, Menlo, monospace; font-size:12.5px;
+  background:var(--code-bg); color:var(--code-ink);
+  padding:1.5px 6px; border-radius:6px; white-space:nowrap;
+}
+.msg.me .bubble code.inline{ background:rgba(255,255,255,.2); color:#fff; }
+
+.code-block{
+  margin-top:8px; border-radius:12px; overflow:hidden;
+  border:1px solid var(--line); background:var(--code-bg);
+  box-shadow:var(--shadow-sm);
+}
+.code-block .cb-top{
+  display:flex; align-items:center; gap:8px; padding:7px 12px;
+  background:color-mix(in oklab, var(--code-bg) 70%, var(--surface));
+  border-bottom:1px solid var(--line); font-size:11px; color:var(--ink-3); font-weight:600;
+}
+.code-block .cb-top .dot{ width:9px; height:9px; border-radius:50%; }
+.code-block pre{
+  margin:0; padding:12px 14px; overflow-x:auto;
+  font-family:"SF Mono", ui-monospace, Menlo, monospace; font-size:12.5px; line-height:1.6;
+  color:var(--ink);
+}
+.tok-key{ color:var(--accent-strong); }
+.tok-str{ color:var(--warm); }
+.tok-com{ color:var(--ink-3); font-style:italic; }
+
+.chips-row{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
+.pill{
+  display:inline-flex; align-items:center; gap:6px;
+  padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600;
+  background:var(--accent-tint); color:var(--accent-strong);
+}
+.pill.warm{ background:var(--warm-soft); color:color-mix(in oklab, var(--warm) 78%, var(--ink)); }
+.pill svg{ width:12px; height:12px; }
+
+.reactions{ display:flex; gap:5px; margin:5px 4px 0; }
+.msg.me .reactions{ justify-content:flex-end; }
+.react{
+  display:inline-flex; align-items:center; gap:5px; padding:2px 9px 2px 8px;
+  border-radius:999px; background:var(--surface); border:1px solid var(--line-soft);
+  font-size:12px; font-weight:600; color:var(--ink-2); box-shadow:var(--shadow-sm);
+  transition:transform .12s var(--ease-soft), border-color .16s var(--ease);
+}
+.react:hover{ transform:translateY(-1px); border-color:var(--accent); }
+.react.on{ background:var(--accent-tint); color:var(--accent-strong); border-color:transparent; }
+.react .r-ic{ font-size:13px; }
+
+/* typing indicator */
+.typing{ display:flex; gap:12px; padding:3px 0; animation:msgIn .3s var(--ease) both; }
+.typing .tb{
+  background:var(--bubble-agent); border:1px solid var(--line-soft); box-shadow:var(--shadow-sm);
+  padding:13px 16px; border-radius:6px 18px 18px 18px;
+  display:flex; align-items:center; gap:5px;
+}
+.typing .tb i{ width:7px; height:7px; border-radius:50%; background:var(--ink-3); display:block; animation:blink 1.3s infinite; }
+.typing .tb i:nth-child(2){ animation-delay:.18s; }
+.typing .tb i:nth-child(3){ animation-delay:.36s; }
+@keyframes blink{ 0%,60%,100%{ transform:translateY(0); opacity:.4; } 30%{ transform:translateY(-4px); opacity:1; } }
+.typing .who-t{ font-size:11.5px; color:var(--ink-3); align-self:flex-end; margin-bottom:4px; }
+
+/* composer */
+.composer-wrap{ padding:8px 26px 20px; }
+.composer-inner{ max-width:820px; margin:0 auto; }
+.composer{
+  background:var(--surface-2); border:1px solid var(--line);
+  border-radius:var(--r-lg); box-shadow:var(--shadow-md);
+  padding:8px 8px 8px 8px;
+  display:flex; flex-direction:column; gap:6px;
+  transition:border-color .2s var(--ease), box-shadow .2s var(--ease);
+}
+.composer.focus{ border-color:var(--accent); box-shadow:var(--shadow-md), 0 0 0 3px var(--focus); }
+.composer textarea{
+  border:none; background:none; resize:none; outline:none;
+  padding:8px 10px 2px; max-height:160px; min-height:24px;
+  line-height:1.5; font-size:14.5px; width:100%;
+}
+.composer textarea::placeholder{ color:var(--ink-3); }
+.comp-bar{ display:flex; align-items:center; gap:4px; padding:0 4px 2px; }
+.comp-tool{
+  width:34px; height:34px; border-radius:10px; display:grid; place-items:center;
+  color:var(--ink-3); transition:all var(--dur) var(--ease);
+}
+.comp-tool:hover{ background:var(--surface-hover); color:var(--ink); }
+.comp-tool svg{ width:18px; height:18px; }
+.comp-spacer{ flex:1; }
+.comp-hint{ font-size:11.5px; color:var(--ink-3); margin-right:6px; }
+.send-btn{
+  height:38px; padding:0 18px; border-radius:12px;
+  background:var(--accent); color:#fff; font-weight:600;
+  display:flex; align-items:center; gap:8px;
+  box-shadow:var(--shadow-sm);
+  transition:transform .12s var(--ease-soft), background .2s var(--ease), opacity .2s;
