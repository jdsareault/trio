+-    for (const m of state.members.values()) {
+-      if (m.id === state.operator.id) continue;
+-      const nameL = (m.name || '').toLowerCase();
+-      if (!frag || nameL.includes(frag) || m.id.toLowerCase().startsWith(frag)) matches.push(m);
+-    }
+-    matches.sort((a, b) => {
