+def get_supervisor() -> "nam.UnifiedAgentSupervisor":
+    global _SUPERVISOR
+    with _SUPERVISOR_LOCK:
+        if _SUPERVISOR is None:
+            _SUPERVISOR = nam.UnifiedAgentSupervisor(
+                db_path=_DB_PATH_GLOBAL, nth_server_path=NTH_SERVER_PATH)
+        return _SUPERVISOR
