+.prov-opt:disabled{ opacity:.55; cursor:not-allowed; }
+.prov-opt .pv-name{ font-weight:700; font-size:14.5px; display:flex; align-items:center; gap:8px; }
+.prov-opt .pv-d{ font-size:11.5px; color:var(--ink-3); margin-top:3px; }
+.prov-opt .soon{ font-size:10px; font-weight:800; padding:1px 7px; border-radius:999px; background:var(--warn-tint); color:color-mix(in oklab,var(--warn) 74%,var(--ink)); }
+.readiness{ display:flex; align-items:center; gap:8px; font-size:12px; font-weight:600; padding:9px 12px; border-radius:11px; margin-top:8px; }
