+/* ============================================================
+   EXTENDED TOKENS — semantic status colors (both themes)
+   ============================================================ */
+:root{
+  --ok:#5b9a6f; --ok-tint:color-mix(in oklab,#5b9a6f 15%, var(--surface));
+  --warn:#c98a3c; --warn-tint:color-mix(in oklab,#c98a3c 16%, var(--surface));
+  --danger:#c05a4d; --danger-tint:color-mix(in oklab,#c05a4d 13%, var(--surface));
+  --info:#4d84c4; --info-tint:color-mix(in oklab,#4d84c4 14%, var(--surface));
+  --sleep:#7b83b8; --sleep-tint:color-mix(in oklab,#7b83b8 15%, var(--surface));
+}
+:root[data-theme="dark"]{
+  --ok:#6fbb88; --ok-tint:color-mix(in oklab,#6fbb88 18%, var(--surface));
+  --warn:#e0a24d; --warn-tint:color-mix(in oklab,#e0a24d 16%, var(--surface));
+  --danger:#e18577; --danger-tint:color-mix(in oklab,#e18577 16%, var(--surface));
+  --info:#7ab0e6; --info-tint:color-mix(in oklab,#7ab0e6 16%, var(--surface));
+  --sleep:#9aa2df; --sleep-tint:color-mix(in oklab,#9aa2df 16%, var(--surface));
+}
+
+/* named-theme retints (applied on top of data-theme) */
+:root[data-palette="nord"]{ --bg:#e7ecf2; --bg-sink:#dde4ee; --surface:#f3f6fa; --surface-2:#fbfcfe; --surface-hover:#e9eef5; --sidebar:#e9eff6; --line:#d2dbe6; --line-soft:#dde4ee; --ink:#2e3440; --ink-2:#4c566a; --ink-3:#7b8698; }
+:root[data-theme="dark"][data-palette="nord"]{ --bg:#2e3440; --bg-sink:#272c36; --surface:#3b4252; --surface-2:#434c5e; --surface-hover:#414a5c; --sidebar:#333a47; --line:#4c566a; --line-soft:#434c5e; --ink:#eceff4; --ink-2:#d8dee9; --ink-3:#9aa5b8; }
+:root[data-theme="dark"][data-palette="dracula"]{ --bg:#282a36; --bg-sink:#21222c; --surface:#343746; --surface-2:#3c3f51; --surface-hover:#3a3d4d; --sidebar:#2d2f3d; --line:#464a5e; --line-soft:#3c3f51; --ink:#f8f8f2; --ink-2:#d5d6e0; --ink-3:#9ea0b5; }
+:root[data-palette="solarized"]{ --bg:#eee5cd; --bg-sink:#e6dcc0; --surface:#fdf6e3; --surface-2:#fffbf0; --surface-hover:#f3ead2; --sidebar:#f0e7cf; --line:#ddd2b4; --line-soft:#e6dcc0; --ink:#3a4b4f; --ink-2:#586e75; --ink-3:#93a1a1; }
+
+/* ============================================================
+   status system — presence chips + rings (label + icon, not color alone)
+   ============================================================ */
+.st-working .st-ring, .st-dot.working{ background:var(--warn); }
+.st-active .st-ring, .st-dot.active{ background:var(--ok); }
+.st-sleeping .st-ring, .st-dot.sleeping{ background:var(--sleep); }
+.st-stopped .st-ring, .st-dot.stopped{ background:var(--st-offline); }
+.st-errored .st-ring, .st-dot.errored{ background:var(--danger); }
+.st-blocked .st-ring, .st-dot.blocked{ background:var(--warm); }
+.st-stale .st-ring, .st-dot.stale{ background:var(--st-offline); box-shadow:0 0 0 2px var(--sidebar); outline:1.5px dashed var(--ink-3); outline-offset:-1px; }
+.st-spawning .st-ring, .st-dot.spawning{ background:var(--accent); }
+.st-working .st-ring{ animation:breathe 2.4s var(--ease) infinite; }
+@keyframes breathe{ 0%,100%{ box-shadow:0 0 0 0 color-mix(in oklab,var(--warn) 55%,transparent);} 50%{ box-shadow:0 0 0 4px color-mix(in oklab,var(--warn) 0%,transparent);} }
+@media (prefers-reduced-motion: reduce){ .st-working .st-ring{ animation:none; } }
