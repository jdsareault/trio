+}
+.av.sq{ border-radius:11px; }
+.av-28{ width:28px; height:28px; font-size:12px; }
+.av-32{ width:32px; height:32px; font-size:13px; }
+.av-40{ width:40px; height:40px; font-size:15px; }
+.av-48{ width:48px; height:48px; font-size:18px; }
+.av-64{ width:64px; height:64px; font-size:24px; }
+.av .st-ring{
+  position:absolute; right:-1px; bottom:-1px;
+  width:12px; height:12px; border-radius:50%;
+  border:2.5px solid var(--sidebar);
+}
+.dm-item .av .st-ring{ border-color:var(--sidebar); }
+.st-online .st-ring, .st-dot.online{ background:var(--st-online); }
+.st-thinking .st-ring, .st-dot.thinking{ background:var(--st-thinking); }
+.st-idle .st-ring, .st-dot.idle{ background:var(--st-idle); }
+.st-offline .st-ring, .st-dot.offline{ background:var(--st-offline); }
+
+.dm-pair{ position:relative; width:30px; height:28px; flex:none; }
+.dm-pair .av{ position:absolute; box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 0 0 2px var(--sidebar); }
+.dm-pair .av:first-child{ left:0; top:0; }
+.dm-pair .av:last-child{ right:0; bottom:0; }
+
+/* sidebar footer / user */
+.side-foot{
+  border-top:1px solid var(--line);
+  padding:10px 12px;
+  display:flex; align-items:center; gap:10px;
+}
+.side-foot .who{ min-width:0; flex:1; }
+.side-foot .who .n{ font-weight:600; font-size:13.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.side-foot .who .s{ font-size:11.5px; color:var(--ink-3); }
+
+/* ============================================================
+   main / conversation
+   ============================================================ */
+.main{ min-width:0; min-height:0; display:flex; flex-direction:column; background:var(--bg); position:relative; }
+
+.topbar{
+  display:flex; align-items:center; gap:14px;
+  padding:14px 22px;
+  border-bottom:1px solid var(--line);
+  background:color-mix(in oklab, var(--bg) 78%, transparent);
+  backdrop-filter:blur(8px);
+  min-height:66px;
+}
+.hamb{ display:none; }
+@media (max-width:880px){ .hamb{ display:grid; } }
+
+.topbar .tt{ min-width:0; flex:1; }
+.topbar h1,.topbar h2{ font-family:var(--font-display); font-size:19px; font-weight:600; letter-spacing:-.01em; display:flex; align-items:center; gap:8px; }
+.topbar h1 .h,.topbar h2 .h{ color:var(--ink-3); font-weight:500; }
+.topbar .topic{ font-size:12.5px; color:var(--ink-3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:1px; }
+.topbar-actions{ display:flex; align-items:center; gap:6px; }
+.topbar-actions .conn{ margin-right:2px; }
+.channel-menu{
+  position:fixed; z-index:var(--z-menu); min-width:218px; padding:6px;
+  background:var(--surface-2); border:1px solid var(--line); border-radius:16px;
+  box-shadow:var(--shadow-lg); opacity:0; pointer-events:none;
+  transform:translateY(-4px) scale(.98); transform-origin:top right;
+  transition:opacity .14s var(--ease), transform .14s var(--ease-soft);
+}
+.channel-menu:not([hidden]){ opacity:1; pointer-events:auto; transform:none; }
+.channel-menu button{ display:flex; align-items:center; gap:11px; width:100%; padding:10px 11px; border-radius:10px; color:var(--ink-2); text-align:left; font-size:13.5px; font-weight:500; }
+.channel-menu button:hover,.channel-menu button:focus-visible{ background:var(--surface-hover); color:var(--ink); outline:none; }
+.channel-menu button svg{ width:17px; height:17px; flex:none; color:var(--ink-3); }
+.channel-menu button.danger{ color:var(--danger); }
+.channel-menu button.danger svg{ color:var(--danger); }
+.channel-menu .menu-sep{ height:1px; margin:6px 4px; background:var(--line-soft); }
+.channel-menu .menu-label{ padding:6px 11px 4px; color:var(--ink-3); font-size:10.5px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; }
+#channel-more-btn.menu-active{ background:var(--accent-tint); color:var(--accent-strong); box-shadow:0 0 0 2px color-mix(in oklab,var(--accent) 52%,transparent); }
+#details-btn.menu-active{ background:var(--accent-tint); color:var(--accent-strong); }
+.channel-drawer{
+  grid-column:3; grid-row:1; min-width:0; min-height:0; width:auto;
+  display:none; flex-direction:column; background:var(--surface); border-left:1px solid var(--line);
+  position:relative;
+}
+.channel-drawer.open{ display:flex; }
+.channel-drawer-resize{ position:absolute; z-index:2; top:0; bottom:0; left:-5px; width:10px; padding:0; cursor:col-resize; border:0; background:transparent; }
+.channel-drawer-resize span{ display:block; width:2px; height:36px; margin:auto; border-radius:99px; background:transparent; transition:background .16s var(--ease); }
+.channel-drawer-resize:hover span,.channel-drawer-resize:focus-visible span,.app.is-resizing .channel-drawer-resize span{ background:var(--accent); }
+.app.is-resizing,.app.is-resizing *{ cursor:col-resize !important; user-select:none !important; }
+.channel-drawer-head{ min-height:78px; padding:18px 28px 14px 32px; display:flex; align-items:center; gap:16px; border-bottom:1px solid var(--line-soft); }
+.channel-drawer-head h2{ flex:1; min-width:0; font-family:var(--font-display); font-size:23px; font-weight:600; letter-spacing:-.015em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.channel-drawer-head .icon-btn{ width:40px; height:40px; border:1.5px solid transparent; border-radius:13px; }
+.channel-drawer-head .icon-btn:hover,.channel-drawer-head .icon-btn:focus-visible{ border-color:var(--accent); background:var(--accent-tint); color:var(--accent-strong); }
+.channel-drawer-body{ flex:1; min-height:0; overflow-y:auto; padding:28px 32px 34px; }
+.channel-drawer-section{ margin-bottom:30px; }
+.channel-drawer-section:last-child{ margin-bottom:0; }
+.channel-drawer-section h3{ margin-bottom:11px; color:var(--ink-3); font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }
+.channel-drawer-topic{ color:var(--ink-2); font-size:15.5px; line-height:1.55; }
+.channel-member{ display:flex; align-items:center; gap:12px; min-height:52px; padding:6px 0; }
+.channel-member .av{ width:42px; height:42px; font-size:15px; }
+.channel-member-copy{ flex:1; min-width:0; }
+.channel-member-name{ font-weight:600; font-size:15px; }
+.channel-member-status{ margin-top:1px; color:var(--ink-3); font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+.channel-status-chip{ display:inline-flex; align-items:center; gap:6px; flex:none; border-radius:999px; padding:6px 11px; font-size:12px; font-weight:700; }
+.channel-status-chip .dot{ width:8px; height:8px; border-radius:50%; background:currentColor; }
+.channel-status-chip.working{ background:var(--warn-tint); color:color-mix(in oklab,var(--warn) 75%,var(--ink)); }
+.channel-status-chip.blocked,.channel-status-chip.errored{ background:var(--danger-tint); color:color-mix(in oklab,var(--danger) 72%,var(--ink)); }
+.channel-status-chip.sleeping{ background:var(--sleep-tint); color:color-mix(in oklab,var(--sleep) 76%,var(--ink)); }
+.channel-status-chip.active,.channel-status-chip.idle{ background:var(--ok-tint); color:color-mix(in oklab,var(--ok) 74%,var(--ink)); }
+.channel-status-chip.offline{ background:var(--bg-sink); color:var(--ink-3); }
+.channel-task{ display:flex; align-items:flex-start; gap:10px; padding:7px 0; color:var(--ink-2); font-size:13.5px; line-height:1.4; }
+.channel-task .tstate{ flex:none; margin-top:1px; }
+.channel-task-text{ min-width:0; }
+.channel-drawer .kv{ padding:10px 0; font-size:15px; }
+.channel-drawer .kv .v{ font-weight:500; }
