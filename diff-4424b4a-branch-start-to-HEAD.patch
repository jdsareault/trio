+  font-size:11.5px; font-weight:700; letter-spacing:.05em; color:var(--ink-3);
+  background:var(--surface); padding:3px 12px; border-radius:999px; box-shadow:var(--shadow-sm);
+}
+
+/* prototype message row, bubble, and code-block superseded by 20-conversation.css */
+
+
+/* typing/reactions removed per 3.12 product decision */
+
+/* composer */
+.composer-wrap{ padding:8px 26px 20px; }
