+-input.addEventListener("keydown", e=>{
+-  const pop=document.getElementById("acPop");
+-  const acOpen = !pop.classList.contains("hidden");
+-  if(acOpen){
+-    if(e.key==="ArrowDown"||e.key==="ArrowUp"){ e.preventDefault(); acHi=Math.max(0,Math.min(acItems.length-1,acHi+(e.key==="ArrowDown"?1:-1))); document.querySelectorAll("#acPop .ac-opt").forEach((n,i)=>n.classList.toggle("hi",i===acHi)); return; }
+-    if(e.key==="Tab" || (e.key==="Enter"&&!e.shiftKey)){ e.preventDefault(); acceptAc(acHi); return; }
