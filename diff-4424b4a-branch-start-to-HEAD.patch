+.channel-drawer-actions{ display:grid; gap:10px; }
+.channel-drawer-actions .btn{ width:100%; justify-content:center; border:1px solid var(--line); background:transparent; }
+.channel-drawer-actions .btn:hover{ background:var(--surface-hover); }
+.channel-drawer-actions .btn.danger{ border-color:color-mix(in oklab,var(--danger) 55%,var(--line)); color:var(--danger); }
+.channel-drawer-actions .btn.danger:hover{ background:var(--danger-tint); }
+.channel-drawer-empty{ color:var(--ink-3); font-size:13.5px; }
+@media (max-width:880px){
