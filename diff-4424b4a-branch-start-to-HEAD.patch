+-    const q = (state.agentStats.get(m.id) || {}).queue_depth || 0;
+-    const qClass = q >= 10 ? 'bad' : (q >= 3 ? 'warn' : 'good');
+-    const sent = (state.agentStats.get(m.id) || {}).sent || 0;
+-    const rate = agentSendRatePerHour(m.id);
+-    const rr = agentReplyRate(m.id);
