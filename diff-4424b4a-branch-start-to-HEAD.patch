+.readiness.warn{ background:var(--warn-tint); color:color-mix(in oklab,var(--warn) 74%,var(--ink)); }
+.readiness svg{ width:15px; height:15px; }
+.perm-choice{ display:flex; flex-direction:column; gap:8px; }
+.perm-opt{ display:flex; gap:12px; padding:12px 14px; border:1.5px solid var(--line); border-radius:13px; background:var(--surface-2); text-align:left; width:100%; transition:all .16s var(--ease); }
